{
  "version": "2026.07.17",
  "description": "Well-known regex patterns for detecting secrets, API keys, and tokens in source files. Maintained manually — only stable, high-signal patterns included.",
  "patterns": [
    {
      "id": "aws-access-key",
      "name": "AWS Access Key ID",
      "regex": "AKIA[0-9A-Z]{16}",
      "severity": "critical"
    },
    {
      "id": "aws-secret-key",
      "name": "AWS Secret Access Key",
      "regex": "(?i)aws_secret_access_key\\s*[=:]\\s*[A-Za-z0-9/+=]{40}",
      "severity": "critical"
    },
    {
      "id": "anthropic-api-key",
      "name": "Anthropic API Key",
      "regex": "sk-ant-[a-zA-Z0-9_-]{80,}",
      "severity": "high"
    },
    {
      "id": "openai-api-key",
      "name": "OpenAI API Key",
      "regex": "sk-[a-zA-Z0-9]{20,}",
      "severity": "high"
    },
    {
      "id": "github-pat",
      "name": "GitHub Personal Access Token",
      "regex": "ghp_[a-zA-Z0-9]{36}",
      "severity": "high"
    },
    {
      "id": "github-oauth",
      "name": "GitHub OAuth Token",
      "regex": "gho_[a-zA-Z0-9]{36}",
      "severity": "high"
    },
    {
      "id": "github-app",
      "name": "GitHub App Token",
      "regex": "ghs_[a-zA-Z0-9]{36}",
      "severity": "high"
    },
    {
      "id": "google-api-key",
      "name": "Google API Key",
      "regex": "AIza[0-9A-Za-z_-]{35}",
      "severity": "high"
    },
    {
      "id": "slack-token",
      "name": "Slack Token",
      "regex": "xox[baprs]-[0-9a-zA-Z]{10,}",
      "severity": "high"
    },
    {
      "id": "stripe-secret",
      "name": "Stripe Secret Key",
      "regex": "sk_live_[0-9a-zA-Z]{24,}",
      "severity": "critical"
    },
    {
      "id": "stripe-publishable",
      "name": "Stripe Publishable Key",
      "regex": "pk_live_[0-9a-zA-Z]{24,}",
      "severity": "medium"
    },
    {
      "id": "twilio-api-key",
      "name": "Twilio API Key",
      "regex": "SK[a-f0-9]{32}",
      "severity": "high"
    },
    {
      "id": "sendgrid-api-key",
      "name": "SendGrid API Key",
      "regex": "SG\\.[a-zA-Z0-9_-]{22}\\.[a-zA-Z0-9_-]{43}",
      "severity": "high"
    },
    {
      "id": "private-key",
      "name": "Private Key Header",
      "regex": "-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----",
      "severity": "critical"
    },
    {
      "id": "generic-secret",
      "name": "Generic Secret Assignment",
      "regex": "(?i)(password|passwd|pwd|secret|token|api_key|apikey|access_key|auth_token)\\s*[=:]\\s*['\"][^'\"]{8,}['\"]",
      "severity": "medium"
    },
    {
      "id": "generic-bearer",
      "name": "Bearer Token",
      "regex": "(?i)bearer\\s+[a-zA-Z0-9_\\-\\.=]{20,}",
      "severity": "medium"
    },
    {
      "id": "deepseek-api-key",
      "name": "DeepSeek API Key",
      "regex": "sk-[a-f0-9]{48}",
      "severity": "high"
    },
    {
      "id": "huggingface-token",
      "name": "HuggingFace Token",
      "regex": "hf_[a-zA-Z0-9]{34}",
      "severity": "high"
    },
    {
      "id": "npm-token",
      "name": "npm Auth Token",
      "regex": "npm_[a-zA-Z0-9]{36}",
      "severity": "high"
    },
    {
      "id": "database-url",
      "name": "Database Connection URL",
      "regex": "(?i)(postgres|mysql|mongodb|redis)://[^\\s'\"]{10,}",
      "severity": "high"
    }
  ]
}
